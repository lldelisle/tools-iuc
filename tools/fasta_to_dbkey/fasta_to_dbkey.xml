<tool id="fasta_to_dbkey" name="Get dbkey parameter value" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="20.01" tool_type="expression" license="MIT">
    <description>from cached genome</description>
    <macros>
        <token name="@TOOL_VERSION@">0.1.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
    </macros>
    <!-- I put data management but I am not sure it is the good one -->
    <edam_topics>
        <edam_topic>topic_3071</edam_topic>
    </edam_topics>
    <!-- I put query retrieval -->
    <edam_operations>
        <edam_operation>operation_0224</edam_operation>
    </edam_operations>
    <xrefs>
        <xref type="bio.tools"></xref>
    </xrefs>
    <expression type="ecma5.1">
{
    return {'output': $job.all_fasta_value};
}
    </expression>
    <inputs>
        <param name="all_fasta_value" type="select" label="Cached genome">
            <options from_data_table="all_fasta"/>
        </param>
    </inputs>
    <outputs>
        <output type="text" name="text_param" from="output" />
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="all_fasta_value" value="fasta_value"/>
            <output name="output">
                <assert_contents>
                    <has_line line="fasta_dbkey"/>
                    <has_n_lines n="1"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

.. class:: infomark

This tools gives the `dbkey` value of the `all_fasta` table for a given `value`.

    ]]></help>
</tool>